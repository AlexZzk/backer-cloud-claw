{
  "name": "@bcc/channel-cli",
  "version": "0.1.0",
  "description": "交互式命令行 AI 对话渠道",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "bcc-chat":   "./dist/bin/bcc-chat.js",
    "bcc-init":   "./dist/bin/bcc-init.js",
    "bcc-skill":  "./dist/bin/bcc-skill.js",
    "bcc-agent":  "./dist/bin/bcc-agent.js",
    "bcc-worker": "./dist/bin/bcc-worker.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start":  "tsx bin/bcc-chat.ts",
    "init":   "tsx bin/bcc-init.ts",
    "worker": "tsx bin/bcc-worker.ts",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bcc/agents": "workspace:*",
    "@bcc/conversation": "workspace:*",
    "@bcc/foundation": "workspace:*",
    "@bcc/memory-episodic": "workspace:*",
    "@bcc/memory-fs": "workspace:*",
    "@bcc/messaging": "workspace:*",
    "@bcc/model-core": "workspace:*",
    "@bcc/org": "workspace:*",
    "@bcc/skills": "workspace:*",
    "@bcc/task": "workspace:*"
  },
  "peerDependencies": {
    "@bcc/protocol-anthropic": "workspace:*",
    "@bcc/protocol-openai": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bcc/protocol-anthropic": { "optional": true },
    "@bcc/protocol-openai": { "optional": true }
  },
  "devDependencies": {
    "@bcc/protocol-anthropic": "workspace:*",
    "@bcc/protocol-openai": "workspace:*",
    "typescript": "*",
    "vitest": "*",
    "@types/node": "*",
    "tsx": "*"
  }
}
