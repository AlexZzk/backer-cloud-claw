{
  "name": "@bcc/memory-fs",
  "version": "0.1.0",
  "description": "文件系统会话记忆存储（无数据库依赖）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bcc/foundation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@types/node": "*"
  }
}
